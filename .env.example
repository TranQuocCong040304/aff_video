# Gemini — CHỈ dùng để xem ảnh/video thật của từng sản phẩm (multimodal).
# Lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Groq — dùng cho mọi bước chỉ cần text (ngách, lọc keyword, lọc sản phẩm,
# hook, CTA, metadata). Free tier rộng hơn Gemini nhiều. Lấy tại
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Giọng edge-tts: vi-VN-HoaiMyNeural (nữ, mặc định) hoặc vi-VN-NamMinhNeural (nam)
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural
